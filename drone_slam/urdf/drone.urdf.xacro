<?xml version="1.0"?>
<!--
  URDF (Unified Robot Description Format) — Drone Kinematic Description
  ======================================================================
  This file defines the "TF Tree" — the tree of spatial transformations
  between the drone's components. ROS2 uses TF to know where each sensor
  is located relative to the robot's center (base_link).

  For this drone, the transform tree looks like this:
    base_link (center of mass)
        └── oak_camera_frame (OAK-S2 camera body)
                ├── oak_rgb_camera_frame     (RGB sensor)
                ├── oak_left_camera_frame    (left stereo camera)
                └── oak_right_camera_frame   (right stereo camera)

  IMPORTANT: The xyz and rpy values in the "base_to_camera" joint MUST
  be physically measured after mounting the camera on the drone!

  ROS coordinate system (REP-103):
    x = forward
    y = left
    z = up
    rpy = (roll, pitch, yaw) in radians

  Example: camera mounted 5cm forward, 2cm up, facing forward:
    <origin xyz="0.05 0.0 0.02" rpy="0.0 0.0 0.0"/>
-->
<robot name="s500_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
    BASE LINK — Drone center of mass
    This is the primary reference frame.
    All other components are defined relative to this frame.
  ============================================================ -->
  <link name="base_link">
    <inertial>
      <!-- Approximate drone mass without battery: ~1.5 kg (HolyBro S500 V2) -->
      <mass value="1.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.029" ixy="0" ixz="0"
               iyy="0.029" iyz="0"
               izz="0.055"/>
    </inertial>
  </link>

  <!-- ============================================================
    OAK-S2 CAMERA
    ADJUST the xyz values to match the actual physical mounting!
    Measure with a ruler from the drone's center of mass to the
    camera's optical center.
  ============================================================ -->
  <joint name="base_to_oak_camera" type="fixed">
    <parent link="base_link"/>
    <child link="oak_camera_frame"/>
    <!--
      xyz: offset in meters (x=forward, y=left, z=up)
      rpy: rotation in radians (roll, pitch, yaw)
      Values below = camera mounted 5cm forward, 2cm up,
      facing forward (parallel to drone axis)
      ⚠️  MEASURE AND UPDATE THESE VALUES BEFORE FIRST FLIGHT!
    -->
    <origin xyz="0.05 0.0 0.02" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="oak_camera_frame">
    <inertial>
      <!-- OAK-S2 mass: ~72g -->
      <mass value="0.072"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>
    <!-- Simplified box geometry for RViz visualization -->
    <visual>
      <geometry>
        <box size="0.097 0.024 0.023"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- ============================================================
    VIRTUAL IMU FRAME
    The OAK-S2 IMU is co-located with the camera body.
    This joint is required by RTAB-Map (wait_imu_to_init parameter).
  ============================================================ -->
  <joint name="oak_to_imu" type="fixed">
    <parent link="oak_camera_frame"/>
    <child link="oak_imu_frame"/>
    <!-- IMU is integrated inside the camera — negligible offset -->
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="oak_imu_frame"/>

  <!-- ============================================================
    CAMERA OPTICAL FRAMES (REP-103)
    ROS standard for optical frame:
      z = forward (along optical axis)
      x = right
      y = down
  ============================================================ -->
  <joint name="oak_to_rgb_frame" type="fixed">
    <parent link="oak_camera_frame"/>
    <child link="oak_rgb_camera_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="oak_rgb_camera_frame"/>

  <joint name="oak_rgb_to_optical_frame" type="fixed">
    <parent link="oak_rgb_camera_frame"/>
    <child link="oak_rgb_camera_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.57079632679 0.0 -1.57079632679"/>
  </joint>

  <link name="oak_rgb_camera_optical_frame"/>

  <!-- Alias link for camera root 'oak' used by depthai-ros -->
  <joint name="oak_camera_to_oak_alias" type="fixed">
    <parent link="oak_camera_frame"/>
    <child link="oak"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="oak"/>

</robot>
