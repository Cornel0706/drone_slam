<?xml version="1.0"?>
<!--
  URDF (Unified Robot Description Format) — Descrierea cinematica a dronei
  =========================================================================
  Acest fisier defineste "TF Tree" — arborele de transformari spatiale
  dintre componentele dronei. ROS2 foloseste TF pentru a sti unde se afla
  fiecare senzor relativ la centrul robotului (base_link).

  Pentru o drona, arborele arata asa:
    base_link (centrul de masa)
        └── oak_camera_frame (camera OAK-S2)
                ├── oak_rgb_camera_frame     (senzor RGB)
                ├── oak_left_camera_frame    (camera stereo stanga)
                └── oak_right_camera_frame   (camera stereo dreapta)

  IMPORTANT: Valorile xyz si rpy din jointul "base_to_camera" trebuie
  masurate fizic dupa ce montezi camera pe drona!
  Sistem de coordonate ROS (REP-103):
    x = inainte
    y = stanga
    z = sus
    rpy = (roll, pitch, yaw) in radiani

  Exemplu: camera montata 5cm in fata, 2cm sus, orientata inainte:
    <origin xyz="0.05 0.0 0.02" rpy="0.0 0.0 0.0"/>
-->
<robot name="s500_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
    BASE LINK — Centrul de masa al dronei
    Acesta este frame-ul de referinta principal.
    Toate celelalte componente sunt definite relativ la acesta.
  ============================================================ -->
  <link name="base_link">
    <inertial>
      <!-- Masa aproximativa a dronei S500 V2 fara baterie: ~1.5kg -->
      <mass value="1.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.029" ixy="0" ixz="0"
               iyy="0.029" iyz="0"
               izz="0.055"/>
    </inertial>
  </link>

  <!-- ============================================================
    CAMERA OAK-S2
    AJUSTEAZA valorile xyz dupa montajul fizic real!
    Masoara cu o rigla distanta de la centrul de masa al dronei
    pana la centrul optic al camerei.
  ============================================================ -->
  <joint name="base_to_oak_camera" type="fixed">
    <parent link="base_link"/>
    <child link="oak_camera_frame"/>
    <!--
      xyz: offset in metri (x=inainte, y=stanga, z=sus)
      rpy: rotatie in radiani (roll, pitch, yaw)
      Valorile de mai jos = camera montata 5cm in fata, 2cm sus
      cu orientare inainte (parallel cu axa dronei)
    -->
    <origin xyz="0.05 0.0 0.02" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="oak_camera_frame">
    <inertial>
      <!-- Masa OAK-S2: ~72g -->
      <mass value="0.072"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>
    <!-- Model vizual simplificat (cutie) pentru RViz -->
    <visual>
      <geometry>
        <box size="0.097 0.024 0.023"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- ============================================================
    IMU VIRTUAL
    IMU-ul OAK-S2 este co-localizat cu camera.
    Acest joint este necesar pentru RTAB-Map (wait_imu_to_init).
  ============================================================ -->
  <joint name="oak_to_imu" type="fixed">
    <parent link="oak_camera_frame"/>
    <child link="oak_imu_frame"/>
    <!-- IMU-ul este integrat in camera, offset neglijabil -->
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="oak_imu_frame"/>

</robot>
